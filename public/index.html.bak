<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>VHS Spandau — PR-Maschine</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;1,400&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --blau:#00285A;--blau80:#375578;--blau60:#69829B;--blau20:#CDD7DC;--blau10:#E6EBF0;
  --gelb:#FAB90F;--rot:#E1000F;--gruen:#AFC805;--hellblau:#64B9E6;--orange:#EB640F;
  --grau:#f4f5f7;
}
body{font-family:'DM Sans',sans-serif;background:var(--grau);color:var(--blau);min-height:100vh}

/* ── LOGIN ── */
#login-screen{
  display:flex;align-items:center;justify-content:center;
  min-height:100vh;background:var(--blau);
  background-image:radial-gradient(circle at 80% 20%, #375578 0%, transparent 50%),
                   radial-gradient(circle at 20% 80%, #1a3550 0%, transparent 40%);
}
.login-box{
  background:#fff;border-radius:16px;padding:40px 36px;
  width:100%;max-width:380px;
  box-shadow:0 24px 60px rgba(0,0,0,.35);
}
.login-logo{display:flex;align-items:center;gap:12px;margin-bottom:28px}
.login-mark{display:flex;align-items:center}
.login-title{font-size:17px;font-weight:700;color:var(--blau);line-height:1.2}
.login-sub{font-size:11px;color:var(--blau60)}
.login-heading{font-size:22px;font-weight:700;color:var(--blau);margin-bottom:6px}
.login-desc{font-size:13px;color:var(--blau60);margin-bottom:24px}
.lf-label{font-size:11px;font-weight:700;color:var(--blau60);text-transform:uppercase;letter-spacing:.6px;margin-bottom:5px}
.lf-input{width:100%;border:1.5px solid #dde2e9;border-radius:9px;padding:11px 13px;font-family:'DM Sans',sans-serif;font-size:14px;color:var(--blau);outline:none;transition:border-color .15s;margin-bottom:14px}
.lf-input:focus{border-color:var(--blau)}
.lf-btn{width:100%;padding:13px;border-radius:9px;font-size:14px;font-weight:700;background:var(--blau);color:#fff;border:none;cursor:pointer;transition:background .15s;margin-top:4px;display:flex;align-items:center;justify-content:center;gap:8px}
.lf-btn:hover{background:#001f47}
.lf-error{background:#FCEBEB;border:1px solid var(--rot);border-radius:7px;padding:9px 12px;font-size:12px;color:#791F1F;margin-bottom:14px;display:none}
.login-hint{margin-top:20px;padding-top:16px;border-top:1px solid #eef1f6;font-size:11px;color:var(--blau60);line-height:1.6}
.login-hint strong{color:var(--blau)}

/* ── APP ── */
#app{display:none;flex-direction:column;min-height:100vh}

/* HEADER */
.header{background:var(--blau);padding:0 22px;height:54px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.logo{display:flex;align-items:center;gap:10px}
.logo-mark{display:flex;align-items:center}
.logo-text{color:#fff;font-size:13px;font-weight:600;line-height:1.2}
.logo-sub{color:var(--blau60);font-size:10px}
.header-right{display:flex;align-items:center;gap:10px}
.user-badge{display:flex;align-items:center;gap:7px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);border-radius:20px;padding:4px 12px 4px 6px}
.user-avatar{width:26px;height:26px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:10px;color:#fff;flex-shrink:0}
.av-admin{background:var(--rot)}
.av-redakteur{background:var(--hellblau)}
.av-pbl{background:var(--gruen)}
.av-direktion{background:var(--gelb)}
.user-name{color:#fff;font-size:12px;font-weight:500}
.user-role{color:rgba(255,255,255,.55);font-size:10px}
.logout-btn{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.15);border-radius:7px;padding:5px 10px;color:rgba(255,255,255,.7);font-size:11px;cursor:pointer;transition:all .15s;font-family:'DM Sans',sans-serif}
.logout-btn:hover{background:rgba(255,255,255,.15);color:#fff}

/* NAV */
.nav{background:#fff;border-bottom:1px solid #dde2e9;display:flex;padding:0 22px;overflow-x:auto;flex-shrink:0}
.nav-tab{padding:11px 18px;font-size:12px;font-weight:500;color:var(--blau60);border-bottom:3px solid transparent;cursor:pointer;white-space:nowrap;display:flex;align-items:center;gap:6px;transition:color .15s}
.nav-tab:hover{color:var(--blau)}
.nav-tab.active{color:var(--blau);border-bottom-color:var(--gelb)}
.nav-tab.hidden{display:none}
.nbadge{background:var(--blau10);color:var(--blau);border-radius:9px;padding:1px 6px;font-size:10px}
.nav-tab.active .nbadge{background:var(--gelb)}

/* MAIN */
.main{flex:1;overflow:hidden;display:flex;flex-direction:column}
.screen{display:none;flex:1;overflow:hidden}
.screen.active{display:flex}

/* ── SCREEN: PBL ── */
#screen-pbl{flex-direction:column;overflow-y:auto;padding:20px 22px;gap:16px}
.pbl-welcome{background:var(--blau);border-radius:12px;padding:20px 22px;color:#fff;display:flex;align-items:center;gap:16px}
.pbl-avatar{width:52px;height:52px;border-radius:50%;background:rgba(255,255,255,.15);display:flex;align-items:center;justify-content:center;font-size:24px;flex-shrink:0}
.pbl-welcome-text h2{font-size:16px;font-weight:600;margin-bottom:3px}
.pbl-welcome-text p{font-size:12px;color:rgba(255,255,255,.7)}
.pbl-pb-badge{background:var(--gelb);color:var(--blau);border-radius:6px;padding:2px 9px;font-size:11px;font-weight:700;margin-top:6px;display:inline-block}

.section-label{font-size:10px;font-weight:700;color:var(--blau60);text-transform:uppercase;letter-spacing:.8px;margin-bottom:8px}
.karten-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:12px}
.karte{background:#fff;border-radius:11px;border:1.5px solid #e2e7ef;overflow:hidden;cursor:pointer;transition:all .15s}
.karte:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,40,90,.1);border-color:var(--blau60)}
.karte.eingereicht{border-color:var(--gruen);background:#f9fce8}
.karte-top{padding:13px 15px 9px;display:flex;gap:11px;align-items:flex-start}
.karte-icon{width:42px;height:42px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
.karte-meta{flex:1;min-width:0}
.karte-datum{font-size:10px;font-weight:500;color:var(--blau60);font-family:'DM Mono',monospace;margin-bottom:2px}
.karte-titel{font-size:13px;font-weight:600;color:var(--blau);line-height:1.3}
.karte-typ{display:inline-block;font-size:9px;font-weight:700;padding:2px 7px;border-radius:8px;margin-top:3px;text-transform:uppercase;letter-spacing:.3px}
.t-jt{background:#E6F1FB;color:#185FA5}
.t-ve{background:#FEF3DA;color:#996B00}
.t-ks{background:#EAF3DE;color:#3B6D11}
.t-an{background:#FCF0FA;color:#7A2A8C}
.karte-body{padding:0 15px 11px;font-size:11px;color:var(--blau60);line-height:1.5}
.karte-footer{padding:9px 15px;border-top:1px solid #eef1f6;display:flex;align-items:center;justify-content:space-between;gap:8px}
.karte-cta{flex:1;padding:7px;border-radius:7px;font-size:11px;font-weight:700;background:var(--blau);color:#fff;border:none;cursor:pointer;transition:background .15s;display:flex;align-items:center;justify-content:center;gap:5px}
.karte-cta:hover{background:#001f47}
.karte.eingereicht .karte-cta{background:var(--gruen)}
.einr-badge{display:none;align-items:center;gap:3px;font-size:10px;font-weight:700;color:#3B6D11;padding:3px 8px;background:#e8f7b0;border-radius:8px}
.karte.eingereicht .einr-badge{display:flex}

/* ── MODAL ── */
.modal-bg{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:100;align-items:center;justify-content:center;padding:16px}
.modal-bg.open{display:flex}
.modal{background:#fff;border-radius:14px;width:100%;max-width:460px;overflow:hidden;box-shadow:0 24px 60px rgba(0,0,0,.3);animation:slideUp .2s ease}
@keyframes slideUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
.modal-head{padding:18px 22px 14px;border-bottom:1px solid #eef1f6;display:flex;gap:13px;align-items:flex-start}
.modal-icon{width:46px;height:46px;border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0}
.modal-title{font-size:15px;font-weight:600;color:var(--blau);line-height:1.3}
.modal-datum{font-size:11px;color:var(--blau60);margin-top:2px;font-family:'DM Mono',monospace}
.modal-body{padding:18px 22px}
.mf-label{font-size:10px;font-weight:700;color:var(--blau60);text-transform:uppercase;letter-spacing:.6px;margin-bottom:5px}
.mf-input,.mf-textarea,.mf-select{width:100%;border:1.5px solid #dde2e9;border-radius:7px;padding:8px 11px;font-family:'DM Sans',sans-serif;font-size:12px;color:var(--blau);outline:none;transition:border-color .15s;background:#fff;margin-bottom:12px}
.mf-input:focus,.mf-textarea:focus,.mf-select:focus{border-color:var(--blau)}
.mf-textarea{resize:vertical;min-height:70px;line-height:1.5}
.mf-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.modal-foot{padding:14px 22px 18px;border-top:1px solid #eef1f6;display:flex;gap:9px;justify-content:flex-end}
.btn-cancel{padding:8px 16px;border-radius:7px;font-size:12px;font-weight:500;background:#fff;border:1.5px solid #dde2e9;color:var(--blau60);cursor:pointer}
.btn-submit{padding:8px 20px;border-radius:7px;font-size:12px;font-weight:700;background:var(--blau);color:#fff;border:none;cursor:pointer;display:flex;align-items:center;gap:5px}
.btn-submit:hover{background:#001f47}

/* ── SCREEN: REDAKTEUR ── */
#screen-redakteur{flex-direction:row;overflow:hidden}
.red-left{width:350px;background:#fff;border-right:1px solid #dde2e9;overflow-y:auto;padding:18px 20px;display:flex;flex-direction:column;gap:14px;flex-shrink:0}
.red-right{flex:1;overflow-y:auto;padding:18px 20px;display:flex;flex-direction:column;gap:13px}
.sl{font-size:10px;font-weight:700;color:var(--blau60);text-transform:uppercase;letter-spacing:.7px;margin-bottom:5px}
.inbox-item{padding:10px 12px;border-radius:9px;border:1.5px solid #e2e7ef;cursor:pointer;transition:all .15s;display:flex;gap:10px;align-items:center}
.inbox-item:hover{border-color:var(--blau60)}
.inbox-item.sel{border-color:var(--blau);background:var(--blau10)}
.ii-icon{font-size:20px;width:30px;text-align:center;flex-shrink:0}
.ii-info{flex:1;min-width:0}
.ii-anlass{font-size:12px;font-weight:600;color:var(--blau);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ii-kurs{font-size:10px;color:var(--blau60);margin-top:1px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ii-pill{font-size:9px;font-weight:700;padding:2px 6px;border-radius:7px;flex-shrink:0;text-transform:uppercase}
.p-neu{background:#FEF3DA;color:#996B00}.p-ok{background:#EAF3DE;color:#3B6D11}
.fi,.ft{width:100%;border:1.5px solid #dde2e9;border-radius:7px;padding:8px 10px;font-family:'DM Sans',sans-serif;font-size:12px;color:var(--blau);outline:none;transition:border-color .15s;background:#fff}
.fi:focus,.ft:focus{border-color:var(--blau)}
.ft{resize:vertical;min-height:60px;line-height:1.5}
.chip-row{display:flex;gap:5px;flex-wrap:wrap}
.chip{padding:4px 11px;border-radius:16px;font-size:11px;font-weight:500;border:1.5px solid #dde2e9;cursor:pointer;transition:all .15s;background:#fff;color:var(--blau60)}
.chip.on{background:var(--blau);border-color:var(--blau);color:#fff}
.chip.ig-on{background:#E1306C;border-color:#E1306C;color:#fff}
.chip.fb-on{background:#1877F2;border-color:#1877F2;color:#fff}
.regel{background:#FEF9EC;border:1px solid var(--gelb);border-radius:7px;padding:9px 12px;font-size:11px;color:#6B4800;line-height:1.5}
.gen-btn{width:100%;padding:11px;border-radius:9px;font-size:13px;font-weight:700;background:var(--blau);color:#fff;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:7px;transition:background .15s}
.gen-btn:hover:not(:disabled){background:#001f47}
.gen-btn:disabled{background:var(--blau60);cursor:not-allowed}
.spinner{width:15px;height:15px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.empty{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:1;padding:40px;text-align:center;color:var(--blau60)}
.empty-icon{font-size:44px;margin-bottom:10px}
.empty-title{font-size:14px;font-weight:600;color:var(--blau);margin-bottom:4px}
.post-karte{background:#fff;border-radius:11px;border:1.5px solid #e2e7ef;overflow:hidden;animation:fadeUp .2s ease}
@keyframes fadeUp{from{opacity:0;transform:translateY(7px)}to{opacity:1;transform:none}}
.pk-head{padding:10px 14px;border-bottom:1px solid #eef1f6;display:flex;align-items:center;justify-content:space-between}
.pk-kanal{font-size:12px;font-weight:700;display:flex;align-items:center;gap:5px}
.c-ig{color:#E1306C}.c-fb{color:#1877F2}
.pk-acts{display:flex;gap:5px}
.pk-btn{padding:4px 9px;border-radius:6px;font-size:11px;font-weight:600;border:1.5px solid #dde2e9;background:#fff;cursor:pointer;color:var(--blau60);transition:all .15s}
.pk-btn:hover{border-color:var(--blau);color:var(--blau)}
.pk-btn.copied{background:var(--gruen);border-color:var(--gruen);color:#fff}
.pk-body{padding:14px}
.post-text{font-size:12px;line-height:1.7;color:var(--blau);white-space:pre-wrap;outline:none;border-radius:5px;padding:4px;margin:-4px;transition:background .15s}
.post-text:focus{background:var(--blau10)}
.char-info{font-size:10px;color:var(--blau60);margin-top:5px;font-family:'DM Mono',monospace}
.char-warn{color:var(--orange)}
.pk-foot{padding:8px 14px;border-top:1px solid #eef1f6;display:flex;align-items:flex-start;gap:8px}
.pk-tags{font-size:10px;color:var(--hellblau);font-family:'DM Mono',monospace;line-height:1.4;flex:1}
.pk-ziel{font-size:9px;font-weight:700;padding:3px 7px;border-radius:7px;background:var(--blau10);color:var(--blau);flex-shrink:0}
.freigabe{background:#fff;border-radius:11px;border:1.5px solid #e2e7ef;padding:14px}
.fg-title{font-size:12px;font-weight:600;color:var(--blau);margin-bottom:10px}
.fg-row{display:flex;gap:7px}
.fg-btn{flex:1;padding:8px;border-radius:7px;font-size:11px;font-weight:600;border:1.5px solid;cursor:pointer;transition:all .15s;background:#fff;display:flex;align-items:center;justify-content:center;gap:4px}
.fg-plan{color:#185FA5;border-color:var(--hellblau)}.fg-plan:hover{background:#E6F1FB}
.fg-ok{color:#3B6D11;border-color:var(--gruen)}.fg-ok:hover{background:#EAF3DE}

/* ── SCREEN: ADMIN ── */
#screen-admin{flex-direction:column;overflow-y:auto;padding:20px 22px;gap:16px}
.admin-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:10px}
.user-card{background:#fff;border-radius:11px;border:1.5px solid #e2e7ef;padding:13px 15px;display:flex;align-items:center;gap:12px;transition:border-color .15s}
.user-card.inaktiv{opacity:.5;background:#f8f8f8}
.uc-avatar{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;color:#fff;flex-shrink:0}
.uc-info{flex:1;min-width:0}
.uc-name{font-size:13px;font-weight:600;color:var(--blau)}
.uc-pb{font-size:10px;color:var(--blau60);margin-top:1px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.uc-role{font-size:10px;font-weight:700;padding:2px 8px;border-radius:8px;margin-top:4px;display:inline-block;text-transform:uppercase;letter-spacing:.3px}
.role-admin{background:#FCEBEB;color:var(--rot)}
.role-redakteur{background:#E6F1FB;color:#185FA5}
.role-pbl{background:#EAF3DE;color:#3B6D11}
.role-direktion{background:#FEF3DA;color:#996B00}
.uc-actions{display:flex;gap:4px;flex-shrink:0}
.uc-btn{padding:4px 9px;border-radius:6px;font-size:10px;font-weight:600;border:1.5px solid;cursor:pointer;background:#fff;transition:all .15s;font-family:'DM Sans',sans-serif}
.uc-btn.edit{color:#185FA5;border-color:var(--hellblau)}.uc-btn.edit:hover{background:#E6F1FB}
.uc-btn.toggle-on{color:#3B6D11;border-color:var(--gruen)}.uc-btn.toggle-on:hover{background:#EAF3DE}
.uc-btn.toggle-off{color:#996B00;border-color:var(--orange)}.uc-btn.toggle-off:hover{background:#FEF3DA}
.uc-btn.del{color:var(--rot);border-color:var(--rot)}.uc-btn.del:hover{background:#FCEBEB}
.add-user-btn{display:inline-flex;align-items:center;gap:7px;padding:10px 16px;border-radius:9px;background:var(--blau);color:#fff;border:none;font-family:'DM Sans',sans-serif;font-size:13px;font-weight:700;cursor:pointer;transition:background .15s}
.add-user-btn:hover{background:#001f47}
/* USER MODAL */
.umodal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:200;align-items:center;justify-content:center;padding:16px}
.umodal-overlay.open{display:flex}
.umodal{background:#fff;border-radius:14px;width:100%;max-width:420px;overflow:hidden;box-shadow:0 24px 60px rgba(0,0,0,.3);animation:slideUp .2s ease}
.umodal-head{padding:16px 20px 12px;border-bottom:1px solid #eef1f6;display:flex;align-items:center;justify-content:space-between}
.umodal-title{font-size:14px;font-weight:700;color:var(--blau)}
.umodal-close{background:none;border:none;font-size:18px;cursor:pointer;color:var(--blau60)}
.umodal-body{padding:16px 20px;display:flex;flex-direction:column;gap:10px}
.uf-label{font-size:10px;font-weight:700;color:var(--blau60);text-transform:uppercase;letter-spacing:.6px;margin-bottom:4px}
.uf-input,.uf-select{width:100%;border:1.5px solid #dde2e9;border-radius:7px;padding:9px 11px;font-family:'DM Sans',sans-serif;font-size:13px;color:var(--blau);outline:none;transition:border-color .15s;background:#fff}
.uf-input:focus,.uf-select:focus{border-color:var(--blau)}
.uf-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.uf-hint{font-size:11px;color:var(--blau60);margin-top:2px}
.umodal-foot{padding:12px 20px 16px;border-top:1px solid #eef1f6;display:flex;gap:8px;justify-content:flex-end}
.uf-cancel{padding:8px 14px;border-radius:7px;font-size:12px;font-weight:500;background:#fff;border:1.5px solid #dde2e9;color:var(--blau60);cursor:pointer;font-family:'DM Sans',sans-serif}
.uf-save{padding:8px 18px;border-radius:7px;font-size:12px;font-weight:700;background:var(--blau);color:#fff;border:none;cursor:pointer;font-family:'DM Sans',sans-serif}
.uf-save:hover{background:#001f47}
.uf-error{background:#FCEBEB;border:1px solid var(--rot);border-radius:6px;padding:8px 12px;font-size:12px;color:#791F1F;display:none;margin-bottom:4px}
.stat-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:10px}
.stat-card{background:#fff;border-radius:10px;border:1.5px solid #e2e7ef;padding:14px}
.stat-n{font-size:28px;font-weight:700;color:var(--blau);line-height:1}
.stat-label{font-size:11px;color:var(--blau60);margin-top:3px}
.stat-icon{font-size:20px;margin-bottom:6px}


/* ── MODUS-SCHALTER ── */
.modus-wrap{background:var(--blau10);border-radius:9px;padding:10px 12px;display:flex;flex-direction:column;gap:8px}
.modus-title{font-size:10px;font-weight:700;color:var(--blau60);text-transform:uppercase;letter-spacing:.7px}
.modus-row{display:flex;gap:6px}
.modus-chip{flex:1;padding:8px 6px;border-radius:8px;font-size:11px;font-weight:600;border:1.5px solid #dde2e9;cursor:pointer;background:#fff;color:var(--blau60);text-align:center;transition:all .15s;line-height:1.4}
.modus-chip.on{background:var(--blau);border-color:var(--blau);color:#fff}
.modus-chip .modus-sub{font-size:9px;font-weight:400;display:block;margin-top:1px;opacity:.8}
/* ── MINI-TOGGLE-ZEILE ── */
.mini-toggle-row{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:#fff;border-radius:8px;border:1.5px solid #e2e7ef}
.mt-label{font-size:11px;font-weight:600;color:var(--blau);display:flex;align-items:center;gap:5px}
.mt-sub{font-size:10px;color:var(--blau60);font-weight:400}
/* iOS switch klein */
.sw{position:relative;display:inline-block;width:32px;height:18px;flex-shrink:0}
.sw input{opacity:0;width:0;height:0}
.sw .sl{position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;background:#dde2e9;transition:.2s;border-radius:18px}
.sw .sl:before{position:absolute;content:"";height:12px;width:12px;left:3px;bottom:3px;background:#fff;transition:.2s;border-radius:50%;box-shadow:0 1px 3px rgba(0,0,0,.2)}
.sw input:checked+.sl{background:var(--gelb)}
.sw input:checked+.sl.gruen{background:var(--gruen)}
.sw input:checked+.sl:before{transform:translateX(14px)}
/* Regel-Box dynamisch */
.regel.modus-r7{background:#FEF9EC;border-color:var(--gelb)}
.regel.modus-direkt{background:#E6F1FB;border-color:var(--hellblau)}

/* ── SCREEN: DIREKTION ── */
#screen-direktion{flex-direction:column;overflow-y:auto;padding:20px 22px;gap:16px}

/* SKELETON */
.sk{background:linear-gradient(90deg,#eef1f6 25%,#e2e7ef 50%,#eef1f6 75%);background-size:200% 100%;animation:shimmer 1.2s infinite;border-radius:5px;height:12px;margin-bottom:7px}
@keyframes shimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}

/* TOAST */
.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%) translateY(70px);background:var(--blau);color:#fff;padding:10px 16px;border-radius:9px;font-size:12px;font-weight:500;box-shadow:0 6px 20px rgba(0,0,0,.25);transition:transform .3s;z-index:999;white-space:nowrap;display:flex;align-items:center;gap:7px}
.toast.show{transform:translateX(-50%) translateY(0)}
.t-dot{width:16px;height:16px;border-radius:50%;background:var(--gruen);display:flex;align-items:center;justify-content:center;font-size:9px;font-weight:700}
</style>
</head>
<body>

<!-- ══ LOGIN ══ -->
<div id="login-screen">
  <div class="login-box">
    <div class="login-logo">
      <div class="login-mark"><svg xmlns="http://www.w3.org/2000/svg" width="200" height="44" viewBox="0 0 200 44"><text x="0" y="30" font-family="Arial,sans-serif" font-size="28" font-weight="700" fill="#00285A">vhs</text><circle cx="70" cy="13" r="5" fill="#9BAAB8"/><circle cx="80" cy="9" r="6" fill="#FAB90F"/><circle cx="91" cy="14" r="5" fill="#64B9E6"/><circle cx="72" cy="25" r="6" fill="#E1000F"/><circle cx="85" cy="28" r="4" fill="#9BAAB8"/><text x="102" y="19" font-family="Arial,sans-serif" font-size="11" font-weight="400" fill="#586481">Volkshochschule</text><text x="102" y="35" font-family="Arial,sans-serif" font-size="15" font-weight="400" fill="#1A2943">Spandau</text></svg></div>
    </div>
    <div class="login-heading">Willkommen</div>
    <div class="login-desc">Bitte melde dich mit deinen Zugangsdaten an.</div>
    <div id="login-error" class="lf-error">Benutzername oder Passwort falsch.</div>
    <div class="lf-label">Benutzername</div>
    <input class="lf-input" id="lf-user" type="text" placeholder="z. B. thomas" autocomplete="username">
    <div class="lf-label">Passwort</div>
    <input class="lf-input" id="lf-pass" type="password" placeholder="••••••••" autocomplete="current-password">
    <button class="lf-btn" onclick="doLogin()">🔐 Anmelden</button>
    <div class="login-hint">
      <strong>Testkonten (alle Passwort: vhs2026!)</strong><br>
      thomas · katja · manuela · kristina · vanessa · marion
    </div>
  </div>
</div>

<!-- ══ APP ══ -->
<div id="app">

  <!-- HEADER -->
  <div class="header">
    <div class="logo">
      <div class="logo-mark"><svg xmlns="http://www.w3.org/2000/svg" width="200" height="40" viewBox="0 0 200 40"><text x="0" y="28" font-family="Arial,sans-serif" font-size="26" font-weight="700" fill="#ffffff">vhs</text><circle cx="68" cy="12" r="5" fill="#9BAAB8"/><circle cx="78" cy="8" r="6" fill="#FAB90F"/><circle cx="89" cy="13" r="5" fill="#64B9E6"/><circle cx="70" cy="23" r="6" fill="#E1000F"/><circle cx="83" cy="26" r="4" fill="#9BAAB8"/><text x="100" y="17" font-family="Arial,sans-serif" font-size="11" font-weight="400" fill="#8BAABF">Volkshochschule</text><text x="100" y="32" font-family="Arial,sans-serif" font-size="15" font-weight="400" fill="#ffffff">Spandau</text></svg></div>
    </div>
    <div class="header-right">
      <div class="user-badge">
        <div class="user-avatar" id="hdr-avatar"></div>
        <div>
          <div class="user-name" id="hdr-name"></div>
          <div class="user-role" id="hdr-role"></div>
        </div>
      </div>
      <button class="logout-btn" onclick="doLogout()">Abmelden</button>
    </div>
  </div>

  <!-- NAV -->
  <div class="nav" id="nav">
    <div class="nav-tab" id="tab-pbl"        onclick="showScreen('pbl')">📬 Kursvorschläge <span class="nbadge" id="nb-pbl">5</span></div>
    <div class="nav-tab" id="tab-redakteur"  onclick="showScreen('redakteur')">✏️ Redaktion</div>
    <div class="nav-tab" id="tab-admin"      onclick="showScreen('admin')">⚙️ Administration <span class="nbadge" id="nb-admin">6</span></div>
    <div class="nav-tab" id="tab-direktion"  onclick="showScreen('direktion')">📊 Dashboard</div>
    <div class="nav-tab" id="tab-performance" onclick="window.open('/performance','_blank')">📊 Performance ↗</div>
    <div class="nav-tab" id="tab-freigabe"   onclick="window.open('/freigabe','_blank')">✅ Freigabe ↗</div>
    <div class="nav-tab" id="tab-editor"     onclick="window.open('/editor','_blank')">🖼 Foto-Editor ↗</div>
    <div class="nav-tab" id="tab-kalender"   onclick="window.open('/kalender','_blank')">📅 Redaktionsplan ↗</div>
    <div class="nav-tab" id="tab-kurse"      onclick="window.open('/kurse','_blank')">📚 Kursliste ↗</div>
  </div>

  <!-- SCREENS -->
  <div class="main">

    <!-- ── PBL ── -->
    <div class="screen" id="screen-pbl">
      <div id="pbl-welcome" class="pbl-welcome" style="margin:20px 22px 0">
        <div class="pbl-avatar" id="pbl-icon">👋</div>
        <div class="pbl-welcome-text">
          <h2 id="pbl-greeting">Hallo!</h2>
          <p>Schlage Kurse für aktuelle Anlässe vor — der Redakteur übernimmt den Rest.</p>
          <div class="pbl-pb-badge" id="pbl-pb-badge"></div>
        </div>
      </div>
      <div style="padding:16px 22px 0">
        <div class="section-label">Aktuelle Anlässe — klicken zum Vorschlagen</div>
        <div class="karten-grid" id="karten-grid"></div>
      </div>
      <div style="padding:16px 22px 20px">
        <div class="section-label" id="status-label" style="display:none">Meine Einreichungen</div>
        <div id="status-liste"></div>
      </div>
    </div>

    <!-- ── REDAKTEUR ── -->
    <div class="screen" id="screen-redakteur">
      <div class="red-left">
        <div>
          <div class="sl">Einreichungen</div>
          <div style="display:flex;flex-direction:column;gap:6px" id="inbox-list">
            <div class="inbox-item sel" onclick="pickInbox(this,0)">
              <div class="ii-icon">🧘</div>
              <div class="ii-info"><div class="ii-anlass">Yogatag — 21. Jun</div><div class="ii-kurs">Yoga Grundkurs · Manuela L.</div></div>
              <div class="ii-pill p-neu">Neu</div>
            </div>
            <div class="inbox-item" onclick="pickInbox(this,1)">
              <div class="ii-icon">🎵</div>
              <div class="ii-info"><div class="ii-anlass">Fête de la Musique</div><div class="ii-kurs">Trommelkurs · Kristina S.</div></div>
              <div class="ii-pill p-neu">Neu</div>
            </div>
            <div class="inbox-item" onclick="pickInbox(this,2)">
              <div class="ii-icon">📷</div>
              <div class="ii-info"><div class="ii-anlass">Welt-Fototag — 10. Aug</div><div class="ii-kurs">Naturfotografie · Vanessa P.</div></div>
              <div class="ii-pill p-ok">Bereit</div>
            </div>
            <div class="inbox-item" onclick="pickInbox(this,3)">
              <div class="ii-icon">🗣</div>
              <div class="ii-info"><div class="ii-anlass">Tag der Sprachen</div><div class="ii-kurs">9 Fremdsprachen · Thomas M.</div></div>
              <div class="ii-pill p-neu">Neu</div>
            </div>
          </div>
        </div>
        <div><div class="sl">Hook / Anlass</div><input class="fi" id="i-anlass" value="Internationaler Yogatag — 21. Juni 2026"></div>
        <div><div class="sl">Kurs &amp; Inhalt</div><input class="fi" id="i-kurs" value="Yoga Grundkurs, Qi Gong, Pilates — Sp3.316-W"></div>
        <div><div class="sl">Idee / Bezug</div><textarea class="ft" id="i-idee">Wer kennt das nicht: Der Alltag hetzt, der Körper kämpft mit. Yoga bringt den Ausgleich — kein Leistungsdruck. Einfach ankommen.</textarea></div>
        <!-- MODUS-SCHALTER -->
        <div class="modus-wrap">
          <div class="modus-title">Post-Modus</div>
          <div class="modus-row">
            <div class="modus-chip on" id="modus-r7" onclick="setModus('r7')">
              🎯 Regel 7
              <span class="modus-sub">Gefühl · Aufhänger</span>
            </div>
            <div class="modus-chip" id="modus-direkt" onclick="setModus('direkt')">
              📣 Direkter Aufruf
              <span class="modus-sub">Kurs · Anmeldung</span>
            </div>
          </div>
        </div>

        <div><div class="sl">Ton</div>
          <div class="chip-row">
            <div class="chip on" onclick="setTon(this,'inspirierend')">💫 Inspirierend</div>
            <div class="chip" onclick="setTon(this,'direkt')">🎯 Direkt</div>
            <div class="chip" onclick="setTon(this,'humorvoll')">😄 Humorvoll</div>
            <div class="chip" onclick="setTon(this,'informativ')">📋 Informativ</div>
          </div>
        </div>
        <div><div class="sl">Kanal</div>
          <div class="chip-row">
            <div class="chip ig-on" id="c-ig" onclick="toggleK('ig')">📸 Instagram</div>
            <div class="chip fb-on" id="c-fb" onclick="toggleK('fb')">👥 Facebook</div>
          </div>
        </div>

        <!-- LINKTREE + KURSINFO TOGGLES -->
        <div style="display:flex;flex-direction:column;gap:6px">
          <div class="mini-toggle-row">
            <div class="mt-label">
              🔗 LinkTree
              <span class="mt-sub">Link im Post einbetten</span>
            </div>
            <label class="sw"><input type="checkbox" id="toggle-linktree" checked><span class="sl"></span></label>
          </div>
          <div id="linktree-url-wrap" style="padding:0 2px">
            <input class="fi" id="i-linktree" type="text" placeholder="https://linktr.ee/vhsspandau" value="https://linktr.ee/vhsspandau" style="font-size:11px;padding:6px 10px">
          </div>
          <div class="mini-toggle-row">
            <div class="mt-label">
              📚 Kursinfo
              <span class="mt-sub">Kursnummer + Titel einbetten</span>
            </div>
            <label class="sw"><input type="checkbox" id="toggle-kursinfo" checked><span class="sl gruen"></span></label>
          </div>
        </div>

        <div class="regel modus-r7" id="regel-box"><strong>Regel Nr. 7 —</strong> Gute Aufhänger benennen ein Gefühl, kein Angebot.</div>
        <button class="gen-btn" id="gen-btn" onclick="generate()">✨ Posts generieren</button>
      </div>
      <div class="red-right" id="red-right">
        <div class="empty"><div class="empty-icon">✨</div><div class="empty-title">Redaktion bereit</div><div style="font-size:12px">Einreichung wählen → Ton → generieren</div></div>
      </div>
    </div>

    <!-- ── ADMIN ── -->
    <div class="screen" id="screen-admin">
      <div style="padding:20px 22px;display:flex;flex-direction:column;gap:16px;overflow-y:auto;flex:1">
        <div>
          <div class="section-label">Systemstatistik</div>
          <div class="stat-grid">
            <div class="stat-card"><div class="stat-icon">👥</div><div class="stat-n" id="stat-users">–</div><div class="stat-label">Benutzer gesamt</div></div>
            <div class="stat-card"><div class="stat-icon">✅</div><div class="stat-n" id="stat-aktiv">–</div><div class="stat-label">Benutzer aktiv</div></div>
            <div class="stat-card"><div class="stat-icon">📬</div><div class="stat-n">5</div><div class="stat-label">Einreichungen offen</div></div>
            <div class="stat-card"><div class="stat-icon">📸</div><div class="stat-n">34</div><div class="stat-label">Posts veröffentlicht</div></div>
          </div>
        </div>
        <div>
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px">
            <div class="section-label" style="margin-bottom:0">Benutzerverwaltung</div>
            <button class="add-user-btn" onclick="openUserModal()">＋ Neuer Benutzer</button>
          </div>
          <div class="admin-grid" id="admin-grid">
            <div style="color:var(--blau60);font-size:13px">Lade Benutzer…</div>
          </div>
        </div>
      </div>
    </div>

    <!-- USER MODAL -->
    <div class="umodal-overlay" id="umodal-overlay" onclick="closeUserModal(event)">
      <div class="umodal">
        <div class="umodal-head">
          <div class="umodal-title" id="umodal-title">Neuer Benutzer</div>
          <button class="umodal-close" onclick="closeUserModalDirect()">✕</button>
        </div>
        <div class="umodal-body">
          <div class="uf-error" id="uf-error"></div>
          <input type="hidden" id="uf-id">
          <div class="uf-row">
            <div>
              <div class="uf-label">Vollständiger Name</div>
              <input class="uf-input" id="uf-name" type="text" placeholder="Vorname Nachname">
            </div>
            <div>
              <div class="uf-label">Benutzername</div>
              <input class="uf-input" id="uf-username" type="text" placeholder="z. B. thomas">
            </div>
          </div>
          <div>
            <div class="uf-label">Passwort <span id="uf-pw-hint" style="text-transform:none;font-weight:400;letter-spacing:0">(leer lassen = nicht ändern)</span></div>
            <input class="uf-input" id="uf-password" type="password" placeholder="Neues Passwort">
          </div>
          <div class="uf-row">
            <div>
              <div class="uf-label">Rolle</div>
              <select class="uf-select" id="uf-role" onchange="updatePBVisibility()">
                <option value="admin">Admin / Chief Editor</option>
                <option value="redakteur">Redakteur</option>
                <option value="pbl" selected>Programmbereichsleitung</option>
                <option value="direktion">Direktion / Gast</option>
              </select>
            </div>
            <div id="uf-pb-wrap">
              <div class="uf-label">Programmbereich</div>
              <select class="uf-select" id="uf-pb">
                <option value="alle">Alle Bereiche</option>
                <option>Deutsch und Integration</option>
                <option>Fremdsprachen</option>
                <option>Gesundheit &amp; Bewegung</option>
                <option>Kultur &amp; Kreativität</option>
                <option>Berufliche Bildung</option>
                <option>Politik &amp; Gesellschaft</option>
                <option>Grundbildung</option>
                <option>Inklusion</option>
              </select>
            </div>
          </div>
        </div>
        <div class="umodal-foot">
          <button class="uf-cancel" onclick="closeUserModalDirect()">Abbrechen</button>
          <button class="uf-save" id="uf-save" onclick="saveUser()">Speichern</button>
        </div>
      </div>
    </div>

    <!-- ── DIREKTION ── -->
    <div class="screen" id="screen-direktion">
      <div style="padding:20px 22px;display:flex;flex-direction:column;gap:16px;overflow-y:auto;flex:1">
        <div>
          <div class="section-label">Übersicht</div>
          <div class="stat-grid">
            <div class="stat-card"><div class="stat-icon">📈</div><div class="stat-n">884</div><div class="stat-label">Beste Reichweite (IG)</div></div>
            <div class="stat-card"><div class="stat-icon">👁</div><div class="stat-n">3.2k</div><div class="stat-label">Ø Reichweite / Monat</div></div>
            <div class="stat-card"><div class="stat-icon">❤️</div><div class="stat-n">4.7%</div><div class="stat-label">Ø Engagement-Rate</div></div>
            <div class="stat-card"><div class="stat-icon">🔗</div><div class="stat-n">128</div><div class="stat-label">Link-Klicks gesamt</div></div>
          </div>
        </div>
        <div style="background:#fff;border-radius:11px;border:1.5px solid #e2e7ef;padding:18px">
          <div class="section-label" style="margin-bottom:12px">Kanal-Vergleich (Ø letzte 3 Monate)</div>
          <div style="display:flex;flex-direction:column;gap:10px">
            <div>
              <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px">
                <span>📸 Instagram</span><span style="font-weight:600;color:var(--blau)">Ø 412 Aufrufe</span>
              </div>
              <div style="height:10px;background:var(--blau10);border-radius:5px;overflow:hidden">
                <div style="height:100%;width:78%;background:#E1306C;border-radius:5px"></div>
              </div>
            </div>
            <div>
              <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px">
                <span>👥 Facebook</span><span style="font-weight:600;color:var(--blau)">Ø 178 Aufrufe</span>
              </div>
              <div style="height:10px;background:var(--blau10);border-radius:5px;overflow:hidden">
                <div style="height:100%;width:34%;background:#1877F2;border-radius:5px"></div>
              </div>
            </div>
          </div>
          <div style="margin-top:12px;font-size:11px;color:var(--blau60)">Instagram erreicht durchschnittlich <strong style="color:var(--blau)">2,3× mehr</strong> Menschen als Facebook.</div>
        </div>
        <div style="background:#fff;border-radius:11px;border:1.5px solid #e2e7ef;padding:18px">
          <div class="section-label" style="margin-bottom:10px">Nur lesen — kein Bearbeiten</div>
          <div style="font-size:13px;color:var(--blau60);line-height:1.6">
            Das Dashboard zeigt alle KPIs in Echtzeit.<br>
            Redaktionsplan und Einreichungen sind einsehbar,<br>aber nicht bearbeitbar für die Direktion.
          </div>
        </div>
      </div>
    </div>

  </div><!-- /main -->
</div><!-- /app -->

<!-- MODAL -->
<div class="modal-bg" id="modal-bg" onclick="closeModal(event)">
  <div class="modal">
    <div class="modal-head">
      <div class="modal-icon" id="modal-icon"></div>
      <div><div class="modal-title" id="modal-title"></div><div class="modal-datum" id="modal-datum"></div></div>
    </div>
    <div class="modal-body">
      <div class="mf-label">Kursvorschlag</div>
      <input class="mf-input" id="mf-kurs" type="text" placeholder="z. B. Yoga Grundkurs, Urban Sketching …">
      <div class="mf-row">
        <div>
          <div class="mf-label">Programmbereich</div>
          <select class="mf-select" id="mf-pb">
            <option>Deutsch und Integration</option>
            <option>Fremdsprachen</option>
            <option>Gesundheit &amp; Bewegung</option>
            <option>Kultur &amp; Kreativität</option>
            <option>Berufliche Bildung</option>
            <option>Politik &amp; Gesellschaft</option>
            <option>Grundbildung</option>
          </select>
        </div>
        <div>
          <div class="mf-label">Kursnummer (opt.) <span id="kurs-lookup-status" style="font-size:10px;color:var(--gruen);font-weight:600"></span></div>
          <input class="mf-input" id="mf-nr" type="text" placeholder="z. B. Sp3.316-W — Titel wird automatisch gefunden" style="margin-bottom:0" oninput="lookupKursnr(this.value)">
        </div>
      </div>
      <div class="mf-label">Idee / Bezug zum Anlass</div>
      <textarea class="mf-textarea" id="mf-idee" placeholder="Warum passt dieser Kurs? Was soll der Post vermitteln?"></textarea>
      <div class="mf-label">Hashtag-Wunsch (opt.)</div>
      <input class="mf-input" id="mf-tags" type="text" placeholder="#vhsspandau #yoga …" style="margin-bottom:0">
    </div>
    <div class="modal-foot">
      <button class="btn-cancel" onclick="closeModalDirect()">Abbrechen</button>
      <button class="btn-submit" onclick="submitModal()">📬 Einreichen</button>
    </div>
  </div>
</div>

<!-- TOAST -->
<div class="toast" id="toast"><div class="t-dot">✓</div><span id="toast-msg"></span></div>

<script>
// ══════════════════════════════════════════════════════════════════════════════
// STATE
// ══════════════════════════════════════════════════════════════════════════════
let currentUser = null;
let ton = 'inspirierend';
let igOn = true, fbOn = true;
let modus = 'r7'; // 'r7' = Regel 7 Aufhänger | 'direkt' = Direkter Kursaufruf
let currentAnlassId = null;
const submitted = {};

// ══════════════════════════════════════════════════════════════════════════════
// AUTH
// ══════════════════════════════════════════════════════════════════════════════
async function doLogin() {
  const u = document.getElementById('lf-user').value.trim();
  const p = document.getElementById('lf-pass').value;
  const errEl = document.getElementById('login-error');
  errEl.style.display = 'none';

  try {
    const r = await fetch('/api/login', {
      method:'POST', credentials:'include',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ username:u, password:p })
    });
    const d = await r.json();
    if (!r.ok) { errEl.style.display='block'; return; }
    currentUser = d.user;
    initApp();
  } catch(e) {
    errEl.style.display = 'block';
    errEl.textContent = 'Server nicht erreichbar.';
  }
}

async function doLogout() {
  await fetch('/api/logout', { method:'POST', credentials:'include' });
  currentUser = null;
  // Alle Nav-Tabs ausblenden und Screens deaktivieren
  document.querySelectorAll('.nav-tab').forEach(t => t.classList.add('hidden'));
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById('app').style.display = 'none';
  document.getElementById('login-screen').style.display = 'flex';
  document.getElementById('lf-user').value = '';
  document.getElementById('lf-pass').value = '';
  document.getElementById('login-error').style.display = 'none';
}

// Enter-Taste im Login
document.addEventListener('keydown', e => {
  if (e.key === 'Enter' && document.getElementById('login-screen').style.display !== 'none') doLogin();
});

// Session beim Laden prüfen
window.addEventListener('load', async () => {
  try {
    const r = await fetch('/api/me', { credentials:'include' });
    if (r.ok) { const d = await r.json(); currentUser = d.user; initApp(); }
  } catch {}
});

// ══════════════════════════════════════════════════════════════════════════════
// APP INITIALISIEREN
// ══════════════════════════════════════════════════════════════════════════════
const ROLE_LABELS = { admin:'Admin', redakteur:'Redakteur', pbl:'Programmbereichsleitung', direktion:'Direktion' };
const ROLE_COLORS = { admin:'av-admin', redakteur:'av-redakteur', pbl:'av-pbl', direktion:'av-direktion' };
const ROLE_INITIALS = u => u.name.split(' ').map(n=>n[0]).join('').slice(0,2).toUpperCase();

// ══════════════════════════════════════════════════════════════════════════════
// KURSLISTE LOOKUP
// ══════════════════════════════════════════════════════════════════════════════
let KURSLISTE = null;

async function ladeKursliste() {
  if (KURSLISTE) return KURSLISTE;
  try {
    const r = await fetch('/kurse.json');
    KURSLISTE = await r.json();
  } catch { KURSLISTE = []; }
  return KURSLISTE;
}

async function lookupKursnr(val) {
  const status = document.getElementById('kurs-lookup-status');
  const kursInput = document.getElementById('mf-kurs');
  if (!val || val.length < 4) { status.textContent = ''; return; }
  const kurse = await ladeKursliste();
  const treffer = kurse.find(k =>
    k.nr.toLowerCase() === val.toLowerCase() ||
    k.nr.toLowerCase().includes(val.toLowerCase())
  );
  if (treffer) {
    status.textContent = '✓ ' + treffer.titel;
    status.style.color = 'var(--gruen)';
    // Kurstitel ins Kursvorschlag-Feld übernehmen wenn noch leer
    if (!kursInput.value.trim()) kursInput.value = treffer.titel;
  } else if (val.length >= 6) {
    status.textContent = 'Nicht gefunden';
    status.style.color = 'var(--rot)';
  }
}

// Kursliste vorladen sobald App initialisiert
function initApp() {
  document.getElementById('login-screen').style.display = 'none';
  document.getElementById('app').style.display = 'flex';

  ladeKursliste(); // Kursliste im Hintergrund vorladen

  // Header
  const av = document.getElementById('hdr-avatar');
  av.textContent = ROLE_INITIALS(currentUser);
  av.className = 'user-avatar ' + ROLE_COLORS[currentUser.role];
  document.getElementById('hdr-name').textContent = currentUser.name;
  document.getElementById('hdr-role').textContent = ROLE_LABELS[currentUser.role];

  // Tabs je Rolle — vollständige Sichtbarkeitsmatrix
  const role = currentUser.role;

  // Alle Tabs erst ausblenden
  document.querySelectorAll('.nav-tab').forEach(t => t.classList.add('hidden'));

  // Sichtbarkeitsmatrix: Rolle → sichtbare Tab-IDs
  const NAV = {
    admin:     ['tab-pbl','tab-redakteur','tab-admin','tab-direktion','tab-editor','tab-kalender','tab-freigabe','tab-performance','tab-kurse'],
    redakteur: ['tab-redakteur','tab-direktion','tab-editor','tab-kalender','tab-freigabe','tab-performance','tab-kurse'],
    pbl:       ['tab-pbl','tab-kalender','tab-kurse'],
    direktion: ['tab-direktion','tab-kalender','tab-performance'],
  };
  (NAV[role] || []).forEach(id => document.getElementById(id)?.classList.remove('hidden'));

  // Startscreen je Rolle
  if (role === 'admin') {
    showScreen('admin');
    loadAdminUsers();
  } else if (role === 'redakteur') {
    showScreen('redakteur');
  } else if (role === 'pbl') {
    showScreen('pbl');
    initPBL();
  } else if (role === 'direktion') {
    showScreen('direktion');
  }

  // URL-Parameter von Freigabe-Seite: direkt zum Generator
  const params = new URLSearchParams(window.location.search);

  // Direktnavigation von externen Seiten via ?screen=
  const screenParam = params.get('screen');
  if (screenParam && ['pbl','redakteur','admin','direktion'].includes(screenParam)) {
    // Tab sichtbar machen falls nötig (Rollencheck bereits passiert)
    document.getElementById('tab-' + screenParam)?.classList.remove('hidden');
    showScreen(screenParam);
    if (screenParam === 'admin') loadAdminUsers();
    if (screenParam === 'pbl')   initPBL();
  }

  if (params.get('einreichung')) {
    // Tab sichtbar machen falls nötig
    document.getElementById('tab-redakteur')?.classList.remove('hidden');
    showScreen('redakteur');
    // Felder vorbelegen
    const anlass = params.get('anlass') || '';
    const kurs   = params.get('kurs')   || '';
    const idee   = params.get('idee')   || '';
    const kursNr = params.get('kursNr') || '';
    setTimeout(() => {
      if (anlass) document.getElementById('i-anlass').value = anlass;
      if (kurs || kursNr) document.getElementById('i-kurs').value = (kursNr ? kursNr + ' — ' : '') + kurs;
      if (idee)  document.getElementById('i-idee').value   = idee;
      // Hinweis-Banner
      const right = document.getElementById('red-right');
      right.innerHTML = `<div style="background:var(--blau10);border:1.5px solid var(--blau20);border-radius:10px;padding:16px 18px;display:flex;align-items:center;gap:12px">
        <span style="font-size:22px">✅</span>
        <div>
          <div style="font-size:13px;font-weight:600;color:var(--blau);margin-bottom:3px">Einreichung geladen</div>
          <div style="font-size:12px;color:var(--blau60)">Felder sind vorbelegt. Ton wählen und Post generieren.</div>
        </div>
      </div>`;
      // URL bereinigen ohne Reload
      window.history.replaceState({}, '', '/');
    }, 100);
  }
}

// ══════════════════════════════════════════════════════════════════════════════
// SCREEN WECHSEL
// ══════════════════════════════════════════════════════════════════════════════
function showScreen(name) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
  document.getElementById('screen-' + name)?.classList.add('active');
  document.getElementById('tab-' + name)?.classList.add('active');
}

// ══════════════════════════════════════════════════════════════════════════════
// PBL SCREEN
// ══════════════════════════════════════════════════════════════════════════════
const ANLAESSE = [
  {id:1, datum:'21. Jun 2026', titel:'Fête de la Musique',       typ:'ve', icon:'🎵', bg:'#FEF3DA', hint:'Musik, Kurse, Community'},
  {id:2, datum:'27. Jun 2026', titel:'Tag der Architektur',       typ:'jt', icon:'🏛', bg:'#E6F1FB', hint:'Urban Sketching, Stadtführungen'},
  {id:3, datum:'10. Aug 2026', titel:'Welt-Fototag',              typ:'jt', icon:'📷', bg:'#E6F1FB', hint:'Naturfotografie, Bildbearbeitung'},
  {id:4, datum:'21. Jun 2026', titel:'Internationaler Yogatag',   typ:'jt', icon:'🧘', bg:'#EAF3DE', hint:'Yoga, Qi Gong, Pilates'},
  {id:5, datum:'04. Sep 2026', titel:'Europ. Tag der Sprachen',   typ:'jt', icon:'🗣', bg:'#E6F1FB', hint:'Alle 9 Fremdsprachen'},
  {id:6, datum:'26. Aug 2026', titel:'Lange Nacht der Museen',    typ:'ve', icon:'🎨', bg:'#FEF3DA', hint:'Kunst, Kulturgeschichte'},
  {id:7, datum:'09. Nov 2026', titel:'Mauerfall-Jahrestag',       typ:'jt', icon:'🕊', bg:'#E6F1FB', hint:'Geschichte, pol. Bildung'},
  {id:8, datum:'Jun–Aug 2026', titel:'Sommerkurse starten',       typ:'ks', icon:'☀️', bg:'#EAF3DE', hint:'Outdoor, Sprachen, Gesundheit'},
];
const TYP_LABEL = {jt:'Jahrestag',ve:'Veranstaltung',ks:'Kursstart',an:'Anlass'};

function initPBL() {
  // Begrüßung
  const icons = {admin:'👑',redakteur:'✏️',pbl:'🌱',direktion:'👁'};
  document.getElementById('pbl-icon').textContent = icons[currentUser.role]||'👋';
  document.getElementById('pbl-greeting').textContent = 'Hallo, ' + currentUser.name.split(' ')[0] + '!';
  document.getElementById('pbl-pb-badge').textContent = currentUser.pb;

  renderKarten();
}

function renderKarten() {
  const grid = document.getElementById('karten-grid');
  grid.innerHTML = ANLAESSE.map(a => {
    const done = submitted[a.id];
    return `<div class="karte${done?' eingereicht':''}" onclick="openModal(${a.id})">
      <div class="karte-top">
        <div class="karte-icon" style="background:${a.bg}">${a.icon}</div>
        <div class="karte-meta">
          <div class="karte-datum">${a.datum}</div>
          <div class="karte-titel">${a.titel}</div>
          <span class="karte-typ t-${a.typ}">${TYP_LABEL[a.typ]}</span>
        </div>
      </div>
      <div class="karte-body">${a.hint}</div>
      <div class="karte-footer">
        <button class="karte-cta" onclick="event.stopPropagation();openModal(${a.id})">
          ${done?'✓ Eingereicht':'📬 Vorschlagen'}
        </button>
        <div class="einr-badge">✓ Gesendet</div>
      </div>
    </div>`;
  }).join('');
}

function openModal(id) {
  currentAnlassId = id;
  const a = ANLAESSE.find(x=>x.id===id);
  document.getElementById('modal-icon').style.background = a.bg;
  document.getElementById('modal-icon').textContent = a.icon;
  document.getElementById('modal-title').textContent = a.titel;
  document.getElementById('modal-datum').textContent = a.datum;
  ['mf-kurs','mf-nr','mf-idee','mf-tags'].forEach(id=>document.getElementById(id).value='');
  document.getElementById('modal-bg').classList.add('open');
}
function closeModal(e){ if(e.target===document.getElementById('modal-bg')) closeModalDirect(); }
function closeModalDirect(){ document.getElementById('modal-bg').classList.remove('open'); }

function submitModal() {
  const kurs = document.getElementById('mf-kurs').value.trim();
  if (!kurs) { document.getElementById('mf-kurs').focus(); return; }
  submitted[currentAnlassId] = true;
  closeModalDirect();
  renderKarten();
  // Status-Liste aktualisieren
  const statusLabel = document.getElementById('status-label');
  const statusListe = document.getElementById('status-liste');
  statusLabel.style.display = 'block';
  const a = ANLAESSE.find(x=>x.id===currentAnlassId);
  statusListe.innerHTML += `<div style="background:#fff;border-radius:9px;border:1.5px solid var(--gruen);padding:12px 14px;margin-bottom:8px;display:flex;align-items:center;gap:12px">
    <div style="font-size:20px">${a.icon}</div>
    <div style="flex:1">
      <div style="font-size:12px;font-weight:600;color:var(--blau)">${a.titel}</div>
      <div style="font-size:11px;color:var(--blau60)">${kurs}</div>
    </div>
    <div style="font-size:10px;font-weight:700;padding:3px 8px;border-radius:8px;background:#EAF3DE;color:#3B6D11">Eingereicht</div>
  </div>`;
  showToast('📬 Vorschlag eingereicht!');
  document.getElementById('nb-pbl').textContent = Object.keys(submitted).length;
}

// ══════════════════════════════════════════════════════════════════════════════
// REDAKTEUR / KI-GENERATOR
// ══════════════════════════════════════════════════════════════════════════════
const INBOX_DATA = [
  {anlass:'Internationaler Yogatag — 21. Juni 2026', kurs:'Yoga Grundkurs, Qi Gong, Pilates — Sp3.316-W', idee:'Wer kennt das nicht: Der Alltag hetzt, der Körper kämpft mit. Yoga bringt den Ausgleich — kein Leistungsdruck.'},
  {anlass:'Fête de la Musique — 21. Juni 2026',      kurs:'Trommelkurs, Percussion für alle — Sp2.731-H', idee:'Berlin klingt an einem Tag wie ein großes Konzert. Wir spielen mit.'},
  {anlass:'Welt-Fototag — 10. August 2026',          kurs:'Naturfotografie — Sp2.610-S',                  idee:'Ein Tag für alle, die die Welt durch ein Objektiv sehen.'},
  {anlass:'Europ. Tag der Sprachen — 4. Sep 2026',   kurs:'9 Fremdsprachen an der VHS Spandau',           idee:'Spandau spricht viele Sprachen — zu Hause, im Kiez, im Freundeskreis.'},
];

function pickInbox(el, idx) {
  document.querySelectorAll('.inbox-item').forEach(i=>i.classList.remove('sel'));
  el.classList.add('sel');
  const d = INBOX_DATA[idx];
  document.getElementById('i-anlass').value = d.anlass;
  document.getElementById('i-kurs').value   = d.kurs;
  document.getElementById('i-idee').value   = d.idee;
  document.getElementById('red-right').innerHTML = '<div class="empty"><div class="empty-icon">✨</div><div class="empty-title">Bereit</div><div style="font-size:12px">Ton wählen und generieren</div></div>';
}

function setTon(el, t) {
  document.querySelectorAll('#screen-redakteur .chip:not(#c-ig):not(#c-fb)').forEach(c=>c.classList.remove('on'));
  el.classList.add('on'); ton = t;
}

function setModus(m) {
  modus = m;
  document.getElementById('modus-r7').classList.toggle('on', m === 'r7');
  document.getElementById('modus-direkt').classList.toggle('on', m === 'direkt');
  const regelBox = document.getElementById('regel-box');
  if (m === 'r7') {
    regelBox.className = 'regel modus-r7';
    regelBox.innerHTML = '<strong>Regel Nr. 7 —</strong> Gute Aufhänger benennen ein Gefühl, kein Angebot.';
  } else {
    regelBox.className = 'regel modus-direkt';
    regelBox.innerHTML = '<strong>Direkter Aufruf —</strong> Klar, konkret, handlungsaufordernd: Kurs, Datum, Anmeldung.';
  }
}

// LinkTree-Toggle: URL-Feld zeigen/verstecken
document.addEventListener('DOMContentLoaded', () => {
  const lt = document.getElementById('toggle-linktree');
  if (lt) lt.addEventListener('change', () => {
    document.getElementById('linktree-url-wrap').style.display = lt.checked ? 'block' : 'none';
  });
});
function toggleK(k) {
  if(k==='ig'){igOn=!igOn;document.getElementById('c-ig').className='chip'+(igOn?' ig-on':'');}
  else{fbOn=!fbOn;document.getElementById('c-fb').className='chip'+(fbOn?' fb-on':'');}
}

async function generate() {
  if (!igOn && !fbOn) { showToast('Bitte mindestens einen Kanal wählen'); return; }
  const btn = document.getElementById('gen-btn');
  btn.disabled = true;
  btn.innerHTML = '<div class="spinner"></div> Claude schreibt…';

  const anlass = document.getElementById('i-anlass').value;
  const kurs   = document.getElementById('i-kurs').value;
  const idee   = document.getElementById('i-idee').value;
  const right  = document.getElementById('red-right');
  const kanaele = [igOn&&'Instagram',fbOn&&'Facebook'].filter(Boolean).join(' und ');

  right.innerHTML = (igOn?skelCard('📸 Instagram','c-ig'):'') + (fbOn?skelCard('👥 Facebook','c-fb'):'');

  // Optionen lesen
  const mitLinktree  = document.getElementById('toggle-linktree')?.checked;
  const linktreeUrl  = document.getElementById('i-linktree')?.value?.trim() || 'https://linktr.ee/vhsspandau';
  const mitKursinfo  = document.getElementById('toggle-kursinfo')?.checked;

  // Modus-spezifische Anweisung
  const modusAnweisung = modus === 'r7'
    ? 'MODUS REGEL 7: Beginne mit einem Gefühl oder einer Beobachtung aus dem Alltag. Verkaufe NICHT direkt das Angebot. Der Kurs erscheint erst im zweiten Teil als natürliche Lösung — nie als Hauptbotschaft.'
    : 'MODUS DIREKTER AUFRUF: Klarer, handlungsauffordernder Post. Nenne Kursname, Kursnummer (falls vorhanden), Starttermin, Anmeldemöglichkeit. Direkt, konkret, keine langen Einleitungen. CTA am Ende.';

  // Kursinfo-Anweisung
  const kursinfoAnweisung = mitKursinfo
    ? `KURSINFO EINBETTEN: Integriere Kursname und Kursnummer organisch in den Post. Format: „${kurs}".`
    : 'KURSINFO WEGLASSEN: Nenne keinen konkreten Kursnamen oder Kursnummer im Post. Der Post bleibt allgemein und atmosphärisch.';

  // LinkTree-Anweisung
  const linktreeAnweisung = mitLinktree
    ? `LINKTREE: Füge am Ende des Posts einen Verweis auf den LinkTree ein. Instagram: „Alle Infos + Anmeldung: Link in der Bio (${linktreeUrl})" — oder kürzer für IG. Facebook: URL direkt nennen.`
    : 'LINK WEGLASSEN: Keinen Link und keine URL im Post nennen.';

  try {
    const r = await fetch('/api/generate', {
      method:'POST', credentials:'include',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        model:'claude-haiku-4-5-20251001',
        max_tokens:1200,
        system:`Du bist Redakteur der Volkshochschule Berlin-Spandau.\nTON: ${ton}\n${modusAnweisung}\n${kursinfoAnweisung}\n${linktreeAnweisung}\nDu-Form IG, Sie-Form FB. Kurze Sätze. Zeilenumbrüche für Rhythmus. Max 3 Emojis auf IG.\nFormat: === INSTAGRAM ===\\n[Text]\\nHASHTAGS: [tags]\\n=== FACEBOOK ===\\n[Text]\\nHASHTAGS: [tags]`,
        messages:[{role:'user',content:`Kanäle: ${kanaele}\nAnlass: ${anlass}\nKurs: ${kurs}\nIdee: ${idee}\n\nNur die Posts, kein Kommentar.`}]
      })
    });
    if (!r.ok) { const e=await r.json(); throw new Error(e.error||'API-Fehler'); }
    const data = await r.json();
    const text = data.content?.[0]?.text||'';
    right.innerHTML = '';
    parseAndRender(text, right, igOn, fbOn);
    right.innerHTML += `<div class="freigabe"><div class="fg-title">🗂 In Redaktionsplan</div><div class="fg-row"><button class="fg-btn fg-plan" onclick="showToast('📅 Geplant')">📅 Planen</button><button class="fg-btn fg-ok" onclick="showToast('✅ Freigabe angefragt')">✅ Freigabe</button></div></div>`;
  } catch(e) {
    right.innerHTML = `<div style="background:#FCEBEB;border:1.5px solid var(--rot);border-radius:10px;padding:16px;font-size:12px;color:#791F1F">⚠️ ${e.message}</div>`;
  }
  btn.disabled=false; btn.innerHTML='✨ Posts generieren';
}

function parseAndRender(text, el, ig, fb) {
  const igM = text.match(/===\s*INSTAGRAM\s*===([\s\S]*?)(?:===\s*FACEBOOK\s*===|$)/i);
  const fbM = text.match(/===\s*FACEBOOK\s*===([\s\S]*?)(?:===\s*INSTAGRAM\s*===|$)/i);
  if (ig && igM) { const {body,tags}=splitTags(igM[1].trim()); el.innerHTML+=buildCard('ig',body,tags||'#vhsspandau #spandau','Reichweite'); }
  if (fb && fbM) { const {body,tags}=splitTags(fbM[1].trim()); el.innerHTML+=buildCard('fb',body,tags||'#vhsspandau','Engagement'); }
  if (!igM&&!fbM) { const {body,tags}=splitTags(text.trim()); if(ig)el.innerHTML+=buildCard('ig',body,tags,'Reichweite'); }
  el.querySelectorAll('.post-text').forEach(pt=>{
    const cid=pt.closest('.pk-body').querySelector('.char-info').id;
    countChars(pt,cid); pt.addEventListener('input',()=>countChars(pt,cid));
  });
}
function splitTags(raw){
  const i=raw.search(/HASHTAGS?:/i);
  if(i===-1){const l=raw.split('\n');const ti=l.findIndex(x=>x.trim().startsWith('#'));if(ti>-1)return{body:l.slice(0,ti).join('\n').trim(),tags:l.slice(ti).join(' ').trim()};return{body:raw,tags:''};}
  return{body:raw.slice(0,i).trim(),tags:raw.slice(i).replace(/HASHTAGS?:\s*/i,'').trim()};
}
function buildCard(k,body,tags,ziel){
  const uid=k+Date.now()+Math.random().toString(36).slice(2,4);
  const tid='pt'+uid,hid='ph'+uid,cid='cc'+uid;
  return `<div class="post-karte"><div class="pk-head"><div class="pk-kanal c-${k}">${k==='ig'?'📸 Instagram':'👥 Facebook'}</div><div class="pk-acts"><button class="pk-btn" data-tid="${tid}" data-hid="${hid}" onclick="copyPost(this)">Kopieren</button></div></div><div class="pk-body"><div class="post-text" id="${tid}" contenteditable="true">${esc(body)}</div><div class="char-info" id="${cid}"></div></div><div class="pk-foot"><div class="pk-tags" id="${hid}">${esc(tags)}</div><div class="pk-ziel">Ziel: ${ziel}</div></div></div>`;
}
function skelCard(label,cls){return`<div class="post-karte"><div class="pk-head"><div class="pk-kanal ${cls}">${label}</div></div><div class="pk-body" style="padding:14px"><div class="sk" style="width:100%"></div><div class="sk" style="width:82%"></div><div class="sk" style="width:91%"></div><div class="sk" style="width:68%"></div></div></div>`;}
function countChars(el,cid){const n=el.textContent.length;const isIG=!!el.closest('.post-karte').querySelector('.c-ig');document.getElementById(cid).textContent=n+' Zeichen';document.getElementById(cid).className='char-info'+(n>(isIG?300:500)?' char-warn':'');}
function copyPost(btn){const t=document.getElementById(btn.dataset.tid).textContent;const h=document.getElementById(btn.dataset.hid).textContent;navigator.clipboard.writeText(t+'\n\n'+h).then(()=>{btn.textContent='✓';btn.classList.add('copied');setTimeout(()=>{btn.textContent='Kopieren';btn.classList.remove('copied')},2000)});}

// ══════════════════════════════════════════════════════════════════════════════
// ══════════════════════════════════════════════════════════════════════════════
// BENUTZERVERWALTUNG (Admin)
// ══════════════════════════════════════════════════════════════════════════════
let editingUserId = null;

async function loadAdminUsers() {
  const r = await fetch('/api/users', { credentials:'include' });
  if (!r.ok) return;
  const { users } = await r.json();
  document.getElementById('stat-users').textContent = users.length;
  document.getElementById('stat-aktiv').textContent = users.filter(u => u.aktiv !== false).length;
  document.getElementById('admin-grid').innerHTML = users.map(u => {
    const inaktiv = u.aktiv === false;
    return `<div class="user-card${inaktiv?' inaktiv':''}">
      <div class="uc-avatar ${ROLE_COLORS[u.role]}">${ROLE_INITIALS(u)}</div>
      <div class="uc-info">
        <div class="uc-name">${esc(u.name)}${inaktiv?' <span style="font-size:10px;color:var(--blau60)">(deaktiviert)</span>':''}</div>
        <div class="uc-pb">${esc(u.pb||'alle')} · @${esc(u.username)}</div>
        <div class="uc-role role-${u.role}">${ROLE_LABELS[u.role]}</div>
      </div>
      <div class="uc-actions">
        <button class="uc-btn edit" onclick="openUserModal('${u.id}')">✏️</button>
        <button class="uc-btn ${inaktiv?'toggle-off':'toggle-on'}" onclick="toggleUser('${u.id}',${!inaktiv})">${inaktiv?'🔓':'🔒'}</button>
        <button class="uc-btn del" onclick="deleteUser('${u.id}','${esc(u.name)}')">🗑</button>
      </div>
    </div>`;
  }).join('');
}

function updatePBVisibility() {
  const role = document.getElementById('uf-role').value;
  document.getElementById('uf-pb-wrap').style.opacity = role === 'pbl' ? '1' : '0.4';
}

async function openUserModal(id) {
  editingUserId = id || null;
  const errEl = document.getElementById('uf-error');
  errEl.style.display = 'none';
  if (id) {
    document.getElementById('umodal-title').textContent = 'Benutzer bearbeiten';
    const r = await fetch('/api/users', { credentials:'include' });
    const { users } = await r.json();
    const u = users.find(x => x.id === id);
    if (!u) return;
    document.getElementById('uf-name').value     = u.name;
    document.getElementById('uf-username').value = u.username;
    document.getElementById('uf-password').value = '';
    document.getElementById('uf-role').value     = u.role;
    document.getElementById('uf-pb').value       = u.pb || 'alle';
  } else {
    document.getElementById('umodal-title').textContent = 'Neuer Benutzer';
    ['uf-name','uf-username','uf-password'].forEach(id => document.getElementById(id).value = '');
    document.getElementById('uf-role').value = 'pbl';
    document.getElementById('uf-pb').value  = 'alle';
  }
  updatePBVisibility();
  document.getElementById('umodal-overlay').classList.add('open');
  setTimeout(() => document.getElementById('uf-name').focus(), 50);
}

function closeUserModal(e) {
  if (e.target === document.getElementById('umodal-overlay')) closeUserModalDirect();
}
function closeUserModalDirect() {
  document.getElementById('umodal-overlay').classList.remove('open');
}

async function saveUser() {
  const errEl    = document.getElementById('uf-error');
  errEl.style.display = 'none';
  const name     = document.getElementById('uf-name').value.trim();
  const username = document.getElementById('uf-username').value.trim().toLowerCase();
  const password = document.getElementById('uf-password').value;
  const role     = document.getElementById('uf-role').value;
  const pb       = document.getElementById('uf-pb').value;
  if (!name || !username) {
    errEl.textContent = 'Name und Benutzername sind Pflichtfelder.';
    errEl.style.display = 'block'; return;
  }
  if (!editingUserId && !password) {
    errEl.textContent = 'Für neue Benutzer ist ein Passwort erforderlich.';
    errEl.style.display = 'block'; return;
  }
  const body = { name, username, role, pb };
  if (password) body.password = password;
  const url = editingUserId ? `/api/users/${editingUserId}` : '/api/users';
  const method = editingUserId ? 'PUT' : 'POST';
  const r = await fetch(url, { method, credentials:'include',
    headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
  const d = await r.json();
  if (!r.ok) { errEl.textContent = d.error||'Fehler beim Speichern.'; errEl.style.display='block'; return; }
  closeUserModalDirect();
  showToast(editingUserId ? `✅ ${name} aktualisiert` : `✅ ${name} erstellt`);
  loadAdminUsers();
}

async function toggleUser(id, aktiv) {
  const r = await fetch(`/api/users/${id}`, { method:'PUT', credentials:'include',
    headers:{'Content-Type':'application/json'}, body: JSON.stringify({ aktiv }) });
  if (r.ok) { showToast(aktiv ? '🔓 Aktiviert' : '🔒 Gesperrt'); loadAdminUsers(); }
}

async function deleteUser(id, name) {
  if (!confirm(`Benutzer „${name}" wirklich löschen?\nDiese Aktion kann nicht rückgängig gemacht werden.`)) return;
  const r = await fetch(`/api/users/${id}`, { method:'DELETE', credentials:'include' });
  const d = await r.json();
  if (!r.ok) { showToast('⚠️ ' + (d.error||'Fehler')); return; }
  showToast(`🗑 ${name} gelöscht`); loadAdminUsers();
}


// ══════════════════════════════════════════════════════════════════════════════
// UTILS
// ══════════════════════════════════════════════════════════════════════════════
function esc(s){return(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function showToast(msg){const t=document.getElementById('toast');document.getElementById('toast-msg').textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),3000);}
</script>
</body>
</html>
